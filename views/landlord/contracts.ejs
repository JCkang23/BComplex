<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/portal.css" />
    <title>Contracts</title>
</head>
<body>
    <%- include ('../partials/navbar.ejs') %>

    <div class="contracts-container">
    <h2>Contracts</h2>
    <table class="contracts-table">
        <thead>
        <tr>
            <th>Tenant</th>
            <th>Period</th>
            <th>Status</th>
        </tr>
        </thead>
        <tbody>
        <% tenants.forEach(tenant => { %>
            <tr>
            <td class="tenant-cell">
                <img src="<%= tenant.photo %>" class="profile-pic" alt="">
                <span><%= tenant.name %></span>
            </td>
            <td><%= tenant.period %></td>
            <td>
                <span class="status <%= tenant.status.toLowerCase() %>">
                <%= tenant.status %>
                </span>
            </td>
            </tr>
        <% }) %>
        </tbody>
    </table>
    </div>

</body>
</html>